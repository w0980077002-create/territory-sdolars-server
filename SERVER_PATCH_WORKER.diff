3) Add battle-stone purchase method inside TerritoryDB:
    buyBattleStones(id,pack){
      this.init();
      const packs={
        stones_10:{qty:10,gems:2},
        stones_60:{qty:60,gems:12},
        stones_600:{qty:600,gems:100}
      };
      const x=packs[String(pack||"")];
      if(!x)throw Error("Unknown battle-stone pack");
      const p=this.player(id);
      if(!p)throw Error("Player not found");
      if(Number(p.gems)<x.gems)throw Error("Not enough gems");
      const state=this.gameState(id)||{};
      const before=p.gems;
      state.battleStones=Math.max(0,Number(state.battleStones)||0)+x.qty;
      this.sql.exec(
        `UPDATE players SET gems=?,updated_at=? WHERE telegram_id=?`,
        before-x.gems,now(),id
      );
      this.saveGameState(id,state,true);
      this.sql.exec(
        `INSERT INTO economy_ledger(telegram_id,currency,amount,balance_before,balance_after,kind,reference,reason,created_at)
         VALUES(?,?,?,?,?,?,?,?,?)`,
        id,'gems',-x.gems,before,before-x.gems,'battle_stones_purchase',
        String(pack),'Battle stones purchase',now()
      );
      this.event(id,'Shop','buy_battle_stones',JSON.stringify({pack,qty:x.qty,gems:x.gems}));
      const np=this.player(id);
      return {ok:true,pack,quantity:x.qty,state:this.gameState(id),player:this.playerPayload(id),economy:this.economySnapshot(id)};
    }

4) Add daily check-in method inside TerritoryDB:
    dailyCheckin(id){
      this.init();
      const p=this.player(id);
      if(!p)throw Error("Player not found");
      const state=this.gameState(id)||{};
      const today=new Date().toISOString().slice(0,10);
      if(String(state.dailyCheckinDate||"")===today)throw Error("Ежедневная награда уже получена");
      state.dailyCheckinDate=today;
      state.battleStones=Math.max(0,Number(state.battleStones)||0)+5;
      state.battleStonesBonus=Math.max(0,Number(state.battleStonesBonus)||0);
      this.saveGameState(id,state,true);
      this.event(id,'Daily','checkin',JSON.stringify({date:today,battleStones:5}));
      return {ok:true,reward:{battleStones:5},state:this.gameState(id),player:this.playerPayload(id)};
    }

5) Add chat method to RoomHub:
    async chat(s,id,text){
      const r=Object.values(s.rooms).find(x=>!x.ended&&x.players.some(p=>p.id===id&&!p.left));
      if(!r)throw Error("Бой не найден");
      const me=r.players.find(p=>p.id===id&&!p.left);
      if(!me)throw Error("Игрок не найден");
      const message=String(text||"").trim().slice(0,180);
      if(!message) return;
      r.log.push(`💬 ${me.name}: ${message}`);
      r.log=r.log.slice(-60);
      await this.save(s);
      for(const p of r.players.filter(p=>!p.bot&&!p.left))
        this.send(p.id,{type:"chat",name:me.name,text:message,room:publicRoom(r)});
    }

